    "from dataclasses import dataclass\n",
    "import statsmodels.api as sm\n",
    "\n",
    "@dataclass(frozen=True)\n",
    "class SVARResults:\n",
    "    \"\"\"\n",
    "    Container for the linear SVAR (recursive OLS) results.\n",
    "\n",
